{% render 'partials/head.liquid' %}
<main>
  {% for city in cities %}
    <h2> QuickScan {{ city.city }}</h2>
  {% endfor %}
  <section class="card-container">
    <nav class="tabs-container">
      <a href="#analytics" class="tab active">Analytics</a>
      <a href="#locaties" class="tab">Locaties</a>
    </nav>

    <section id="analytics" class='tab-content card'>
        <section class="monitoring total-data">
            <p><strong>11/38</strong></p>
            <br> <p>Geschikt voor Monitoring</p>
        </section>
        <section class="smart-zone total-data">
            <p><strong>11/38</strong> </p>
            <br><p>Geschikt voor Smart Zone</p>
        </section>
        
        <section class="chart">
        </section>
        <section class="chart">
        </section>
    </section>

    <section id="locaties" class="tab-content card">
        <section class="location-card">
          {% for city in cities %}
            <picture>
              {% if city.picture %}
                <source type="image/avif"
                srcset="https://fdnd-agency.directus.app/assets/{{ city.picture }}?fit=cover&width=1600&quality=80" alt="{{ city.address }}">
                <source type="image/webp"
                srcset="https://fdnd-agency.directus.app/assets/{{ city.picture }}?fit=cover&width=1600&quality=80" alt="{{ city.address }}">
                <img src="https://fdnd-agency.directus.app/assets/{{ city.picture }}?width=600&quality=80" alt="{{ city.address }} loading="lazy" fetchpriority="high"">
                {% else %}
                  <img src="/assets/download.png" fetchpriority="high">
                {% endif %}
              </picture>
            
            <a href="/dashboard/{{ city.city }}/{{ city.address }}">
                <p>{{ city.address }}</p>
            </a>
          {% endfor %}
        </section>
        <button class="add-button" > <a href="/form">Voeg toe</a></button>
    </section>
  </section>
</main>
</body>
{% render 'partials/foot.liquid' %}