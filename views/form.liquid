{% render 'partials/head.liquid' %}
<section class="card">
  <div class="upload-dummy"></div>
<form method="POST">
  <input list="status">
  <datalist id="status"> 
    <option value="Vrij">
    <option value="Bezet">
    <option value="Overtreding">
    <option value="Bestaat Niet">
  </datalist>

  <input list="monitoring">
  <datalist id="monitoring">
    <option value="Geschikt">
    <option value="Zeer Geschikt">
    <option value="Ongeschikt">
    <option value="Neutraal">
  </datalist>

  <input list="smartzone">
  <datalist id="smartzone">
    <option value="Geschikt">
    <option value="Zeer Geschikt">
    <option value="Ongeschikt">
    <option value="Neutraal">
  </datalist>

  <textarea name="address" rows="2" cols="15"></textarea>
  <textarea name="trafficsign" rows="2" cols="15"></textarea>
  <textarea name="time" rows="2" cols="15"></textarea>
  <textarea name="length" rows="2" cols="15"></textarea>
  <textarea name="comment" rows="auto" cols="20"></textarea>

  <button type="button">Opslaan</button>
</form>
</section>
{% render 'partials/foot.liquid' %}
