{% render 'partials/head.liquid' %}
<main>
    <h1>QuickScans Overzicht</h1>
    <section class="index-grid">
{% for city in cities %}
    <section class="city-container">
        
        {% if city.picture %}
            <picture class="city-img">
                <source type="image/avif"
                srcset="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.address }}">
                 <source type="image/webp"
                 srcset="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.address }}">
            <img class="city-img"
                src="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.address }}">
        {% else %}
            <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high" alt="{{ city.address }}">
        {% endif %}
            </picture>
            <h2> <a href="/dashboard/{{ city.city }}">{{ city.city }}</a></h2>
    </section>
{% endfor %}
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Den Haag</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Schagen</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Eindhoven</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Rotterdam</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Arnhem</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high">
        <h2>Zaandam</h2>
    </section>
</section>
</main>
</body>
{% render 'partials/foot.liquid' %}
