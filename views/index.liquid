{% render 'partials/head.liquid' %}
<main>
    <h1>QuickScans Overzicht</h1>
    <section class="index-grid">
{% for city in cities %}
    <section class="city-container">
         <a href="/dashboard/{{ city.city }}">
        {% if city.picture %}
            <picture class="city-img">
                <source type="image/avif"
                srcset="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                width="300" height="300"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.city }}">
                <source type="image/webp"
                srcset="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                width="300" height="300"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.city }}">
            <img class="city-img"
                src="https://fdnd-agency.directus.app/assets/{{ city.picture}}?width=600&quality=80"
                width="300" height="300"
                loading="lazy" 
                fetchpriority="high"
                alt="{{ city.city }}">
        {% else %}
            <img class="city-img" src="/assets/download.png" loading="lazy" fetchpriority="high" alt="{{ city.city }}" width="300" height="300">
        {% endif %}
            </picture>
            <h2>{{ city.city }}</h2>
            </a>
    </section>
{% endfor %}
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Den Haag</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Schagen</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Eindhoven</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Rotterdam</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Arnhem</h2>
    </section>
    <section class="city-container">
        <img class="city-img" src="/assets/download.png" loading="eager" fetchpriority="high" alt="dummy-img">
        <h2>Zaandam</h2>
    </section>
</section>
</main>
</body>
{% render 'partials/foot.liquid' %}
